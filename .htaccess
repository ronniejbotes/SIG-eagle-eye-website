# SIG Eagle Eye: server settings for Apache or LiteSpeed hosting (for example Hostinger).
# Hosts that ignore .htaccess (Netlify, Cloudflare Pages, Vercel) can simply skip this file.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

AddType font/woff2 .woff2
AddType image/webp .webp
AddType application/manifest+json .webmanifest

<IfModule mod_rewrite.c>
  RewriteEngine On

  # One address for the whole site: https://sigeagleeye.com, to match the canonical
  # URLs and the sitemap. www, and sigeagleeye.co.za if it is ever pointed here,
  # redirect to it. This comes before the HTTPS rule so that http://www. reaches
  # https://sigeagleeye.com in one hop, not two.
  RewriteCond %{HTTP_HOST} ^(www\.sigeagleeye\.com|(www\.)?sigeagleeye\.co\.za)$ [NC]
  RewriteRule ^ https://sigeagleeye.com%{REQUEST_URI} [L,R=301]

  # Always serve the site over HTTPS.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Maintenance files are not part of the website: the build tools, git data, any
  # dotfile (except .well-known, which certificates need), docs, scripts and logs.
  RewriteRule ^(tools|\.git)(/|$) - [R=404,L]
  RewriteRule (^|/)\.(?!well-known(/|$)) - [R=404,L]
  RewriteRule \.(md|py|sh|log|bak|sql|ini|lock|dist|orig|swp)$ - [R=404,NC,L]

  # api/ only answers on the lead script.
  RewriteRule ^api/(?!lead\.php$) - [R=404,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  # Browsers remember to use HTTPS for a year. No includeSubDomains, so other
  # subdomains are not forced onto HTTPS.
  Header always set Strict-Transport-Security "max-age=31536000"
  # Kept loose enough for Google Translate (scripts, styles and frames from Google),
  # strict where it matters: no framing by other sites, no plugins, no <base> tricks,
  # and forms only post back to this site.
  Header always set Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
  Header always unset X-Powered-By
  Header unset X-Powered-By
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript text/javascript application/json application/manifest+json image/svg+xml
</IfModule>

# CSS and JS links carry a content hash (?v=...), so they can be cached for a
# year. Pages are always checked for a fresh copy.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>
